{
  "name": "flashtube",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, customizable layer over youtube.com, as a browser extension.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run && node tools/build.mjs"
  },
  "devDependencies": {
    "@tabler/icons": "3.52.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
